{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "构建并运行单元测试",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/build.ps1", "-Tests", "-OutputDirectory", "release"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": "$gcc"
    }
  ]
}
